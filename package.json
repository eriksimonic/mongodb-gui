{
  "name": "mongo-gui",
  "version": "0.0.0",
  "private": true,
  "description": "A desktop MongoDB client with a mongosh-compatible editor.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @mongo-gui/app dev",
    "dev:ui": "pnpm --filter @mongo-gui/ui dev",
    "storybook": "pnpm --filter @mongo-gui/ui storybook",
    "build-storybook": "pnpm --filter @mongo-gui/ui build-storybook",
    "build": "pnpm --filter @mongo-gui/app build",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration --passWithNoTests",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
